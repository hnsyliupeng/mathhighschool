  "bugs": {
    "url": "https://github.com/hnsyliupeng/mathhighschool/issues"
  },
  "homepage": "https://github.com/hnsyliupeng/mathhighschool#readme",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@sparticuz/chromium": "^129.0.0",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^23.11.1"
  }
}
