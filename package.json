{
  "name": "mathbook-3d",
  "version": "1.0.0",
  "description": "把 liuhaopeng543/MathBook 的全部 20 章高中数学笔记装进一本可翻页的 3D 书（单文件、零外部依赖）",
  "main": "index.js",
  "scripts": {
    "build": "node build/build.mjs",
    "build:book": "node tools/md2book.mjs && node build/build-book.mjs",
    "measure": "node tools/measure-pieces.mjs && node tools/md2book.mjs && node build/build-book.mjs",
    "test:book": "node test/book.mjs",
    "test:scenes": "node test/scenes.mjs",
    "test:fill": "node tools/fill-report.mjs",
    "test": "node test/scenes.mjs && node test/book.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnsyliupeng/mathhighschool.git"
  },
  "keywords": [],
